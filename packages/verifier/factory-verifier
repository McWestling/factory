#!/usr/bin/env python3
"""Select and run checks from .factory/verifier.toml. Requires Python 3.11+ and Git."""

import sys

if sys.version_info < (3, 11):
    sys.exit(
        "factory-verifier requires Python 3.11 or newer; "
        "install or upgrade Python and put it on PATH."
    )

import fcntl
import argparse
import json
import os
import tempfile
from datetime import datetime, timezone
from collections import deque
from pathlib import Path
import re
import subprocess
import tomllib


def read_checks(root, commit=None):
    path = Path(".factory/verifier.toml")
    try:
        text = git_output(root, "show", f"{commit}:{path}") if commit else (root / path).read_text(encoding="utf-8")
        data = tomllib.loads(text)
    except (OSError, UnicodeError, tomllib.TOMLDecodeError) as error:
        raise ValueError(f"{path}: {error}") from error

    def invalid(message):
        raise ValueError(f"{path}: {message}")

    if type(data.get("version")) is not int or data["version"] != 1:
        invalid("expected version = 1")
    unknown = data.keys() - {"version", "checks"}
    if unknown:
        invalid(f"unknown keys: {', '.join(sorted(unknown))}")
    tables = data.get("checks", {})
    if not isinstance(tables, dict):
        invalid("checks must be a table")
    for name, fields in tables.items():
        if not re.fullmatch(r"[a-z0-9]+(-[a-z0-9]+)*", name):
            invalid(f"invalid check name: {name}")
        if not isinstance(fields, dict):
            invalid(f"checks.{name} must be a table")
        unknown = fields.keys() - {"run", "paths", "local"}
        if unknown:
            invalid(f"checks.{name}: unknown keys: {', '.join(sorted(unknown))}")
        if type(fields.get("local", True)) is not bool:
            invalid(f"checks.{name}.local must be a boolean")
        command = fields.get("run")
        if not isinstance(command, str) or "\0" in command:
            invalid(f"checks.{name}.run must be a string without NUL characters")
        paths = fields.get("paths")
        if (
            not isinstance(paths, list) or not paths
            or any(not isinstance(path, str) or not path or "\0" in path for path in paths)
        ):
            invalid(
                f"checks.{name}.paths must be a non-empty array of "
                "non-empty strings without NUL characters"
            )
    return tables


def run_check(root, name, check, output=None):
    state = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state")
    lock_path = state / "factory/verifier.lock"
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with lock_path.open("a+", encoding="utf-8") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            message = f"WAIT {name}"
            try:
                lock.seek(0)
                holder = json.load(lock)
                message += (f": {holder['check']} running in {holder['worktree']} "
                            f"(pid {holder['pid']})")
            except (OSError, ValueError, KeyError, TypeError):
                pass
            print(message, flush=True)
            fcntl.flock(lock, fcntl.LOCK_EX)
        lock.seek(0)
        lock.truncate()
        json.dump({"check": name, "worktree": str(root), "pid": os.getpid()}, lock)
        lock.flush()
        status = subprocess.run(
            ["sh", "-c", check["run"]], cwd=root, stdout=output,
            pass_fds=(lock.fileno(),),
            stderr=subprocess.STDOUT if output is not None else None,
        ).returncode
    return status if status >= 0 else 128 - status


def git_output(root, *args):
    return subprocess.check_output(["git", *args], cwd=root, text=True).rstrip("\n")


def plan_checks(root, checks, base, head):
    for sha in (base, head):
        git_output(root, "rev-parse", "--verify", f"{sha}^{{commit}}")
    selected = []
    for name, check in checks.items():
        diff = subprocess.run(
            ["git", "diff", "--quiet", "--no-ext-diff", "--no-textconv",
             f"{base}...{head}", "--", *[f":(glob){path}" for path in check["paths"]]],
            cwd=root,
        )
        if diff.returncode == 1:
            selected.append(name)
        elif diff.returncode != 0:
            diff.check_returncode()
    return {"base": base, "head": head, "checks": selected}


HOOK_MARKER = "# Factory Verifier pre-push hook"


def common_dir(root):
    return (root / git_output(root, "rev-parse", "--git-common-dir")).resolve()


def install_hook(root):
    hook = common_dir(root) / "hooks/pre-push"
    if hook.exists() and HOOK_MARKER not in hook.read_text(encoding="utf-8"):
        print(f"WARNING: leaving foreign hook alone: {hook}", file=sys.stderr)
        return 0
    hook.parent.mkdir(parents=True, exist_ok=True)
    hook.write_text('#!/bin/sh\n' + HOOK_MARKER + '\n'
                    'cd "$(git rev-parse --show-toplevel)" || exit 1\n'
                    'if [ -x scripts/factory-verifier ]; then\n'
                    '  exec scripts/factory-verifier pre-push "$@"\n'
                    'fi\n'
                    'exec packages/verifier/factory-verifier pre-push "$@"\n', encoding="utf-8")
    hook.chmod(0o755)
    return 0


def read_evidence(path):
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return []
    if not isinstance(data, dict) or not isinstance(data.get("passed"), list) or any(
        not isinstance(name, str) for name in data["passed"]
    ):
        raise ValueError(f"invalid evidence: {path}")
    return data["passed"]


def write_evidence(path, passed):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=path.parent,
                                         delete=False) as output:
            temporary = output.name
            json.dump({"passed": passed}, output)
        os.replace(temporary, path)
    finally:
        if temporary and os.path.exists(temporary):
            os.unlink(temporary)


def preflight(root, checks):
    install_hook(root)
    head = git_output(root, "rev-parse", "HEAD")
    tree = git_output(root, "rev-parse", "HEAD^{tree}")
    record = common_dir(root) / "factory-verifier" / f"{tree}.json"

    def unchanged():
        return (not git_output(root, "status", "--porcelain", "--untracked-files=all")
                and git_output(root, "rev-parse", "HEAD") == head)

    clean = unchanged()
    wrote = False
    passed = read_evidence(record) if clean else []
    failed = False
    for name, check in checks.items():
        if not check.get("local", True):
            print(f"SKIP {name} (hosted only)", flush=True)
            continue
        if name in passed:
            print(f"SKIP {name} (already passed)", flush=True)
            continue
        log = record.parent / "logs" / tree / f"{name}.log"
        log.parent.mkdir(parents=True, exist_ok=True)
        with log.open("w", encoding="utf-8") as output:
            status = run_check(root, name, check, output)
        failed |= status != 0
        print(f"{'FAIL' if status else 'PASS'} {name}", flush=True)
        if status:
            print(log, flush=True)
            with log.open(encoding="utf-8", errors="replace") as output:
                print("".join(deque(output, maxlen=20)), end="", flush=True)
        else:
            passed.append(name)
        clean = clean and unchanged()
        if clean:
            write_evidence(record, passed)
            wrote = True
    if not (clean and unchanged()):
        # Earlier checks may have saved partial proof before a later check dirtied HEAD.
        if wrote:
            record.unlink(missing_ok=True)
        print("No evidence saved: worktree was dirty or HEAD changed.", flush=True)
    return int(failed)


def pre_push(root):
    refs = []
    for line in sys.stdin:
        fields = line.split()
        if len(fields) != 4:
            raise ValueError("invalid pre-push ref update")
        ref, sha, remote_ref, remote_sha = fields
        if not re.fullmatch(r"[0-9a-fA-F]{40}|[0-9a-fA-F]{64}", sha):
            raise ValueError("invalid pre-push SHA")
        if remote_ref.startswith("refs/heads/") and set(sha) != {"0"}:
            refs.append({"ref": ref, "sha": sha, "remote_ref": remote_ref})
    state = common_dir(root) / "factory-verifier"
    if "FACTORY_VERIFIER_OVERRIDE" in os.environ:
        reason = os.environ["FACTORY_VERIFIER_OVERRIDE"].strip()
        if not reason:
            raise ValueError("FACTORY_VERIFIER_OVERRIDE must contain a non-empty reason")
        state.mkdir(parents=True, exist_ok=True)
        with (state / "overrides.jsonl").open("a", encoding="utf-8") as output:
            output.write(json.dumps({"time": datetime.now(timezone.utc).isoformat(),
                                     "reason": reason, "refs": refs}) + "\n")
        print(f"UNVERIFIED PUSH: {reason}", file=sys.stderr, flush=True)
        return 0
    blocked = False
    for update in refs:
        checks = read_checks(root, update["sha"])
        local = [name for name, check in checks.items() if check.get("local", True)]
        if not local:
            continue
        tree = git_output(root, "rev-parse", f"{update['sha']}^{{tree}}")
        passed = read_evidence(state / f"{tree}.json")
        missing = [name for name in local if name not in passed]
        if missing:
            blocked = True
            print(f"BLOCK {update['remote_ref']}: missing checks: {', '.join(missing)}. "
                  "Run scripts/factory-verifier preflight. "
                  "Agents need explicit user authorization to use FACTORY_VERIFIER_OVERRIDE.",
                  file=sys.stderr, flush=True)
    return int(blocked)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=False)
    commands.add_parser("preflight", help="run all local checks and save clean-tree evidence")
    commands.add_parser("install-hook", help="install the shared pre-push hook")
    hook = commands.add_parser("pre-push", help="validate pushed branch evidence")
    hook.add_argument("remote", nargs="?")
    hook.add_argument("url", nargs="?")
    plan = commands.add_parser("plan", help="list checks triggered by a code change")
    plan.add_argument("--base", metavar="SHA")
    plan.add_argument("--head", metavar="SHA")
    plan.add_argument("--all", action="store_true", help="list every check")
    run = commands.add_parser("run", help="run one check or every check")
    target = run.add_mutually_exclusive_group(required=True)
    target.add_argument("check", nargs="?")
    target.add_argument("--all", action="store_true")
    args = parser.parse_args()
    if args.command == "plan":
        if args.all and (args.base is not None or args.head is not None):
            plan.error("--all cannot be combined with --base or --head")
        if not args.all and (args.base is None or args.head is None):
            plan.error("provide --all or both --base and --head")
    root = Path(git_output(None, "rev-parse", "--show-toplevel"))
    if args.command == "install-hook":
        return install_hook(root)
    if args.command == "pre-push":
        return pre_push(root)
    checks = read_checks(root)
    if args.command in (None, "preflight"):
        return preflight(root, checks)
    if args.command == "run":
        if args.all:
            failed = False
            for name, check in checks.items():
                status = run_check(root, name, check)
                failed |= status != 0
                print(f"{'FAIL' if status else 'PASS'} {name}", flush=True)
            return int(failed)
        if args.check not in checks:
            raise ValueError(f"unknown check: {args.check}")
        return run_check(root, args.check, checks[args.check])
    result = {"checks": list(checks)} if args.all else plan_checks(root, checks, args.base, args.head)
    print(json.dumps(result))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except subprocess.CalledProcessError as error:
        sys.exit(error.returncode)
    except (OSError, ValueError) as error:
        sys.exit(f"factory-verifier: {error}")
